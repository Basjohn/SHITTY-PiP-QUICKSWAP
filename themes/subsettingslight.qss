/* Main Dialog/Window Styling */
QDialog, QWidget {
    background-color: rgba(255, 255, 255, 0.8);
    color: #000000;
    border: 1px solid #000000;
    border-radius: 8px;
}

/* Title Bar / Header */
QDialog::title {
    color: #2c2c2c;
    font-size: 18px;
    font-weight: bold;
    padding: 10px;
}

/* Main Container */
QFrame, QGroupBox {
    background-color: rgba(250, 250, 250, 0.95);
    border: 1px solid rgba(200, 200, 200, 0.8);
    border-radius: 6px;
    margin: 2px;
}

/* Labels */
QLabel {
    color: #2c2c2c;
    font-size: 14px;
    background-color: transparent;
    padding: 4px;
}

/* Sliders - FORCE CUSTOM HANDLES */
QSlider {
    background: transparent;
    outline: none;
}

QSlider::groove:horizontal {
    border: 1px solid #c0c0c0;
    height: 6px;
    background: #f0f0f0;
    border-radius: 3px;
    margin: 0px;
}

QSlider::handle:horizontal {
    background: #2c2c2c;
    border: 2px solid #c0c0c0;
    width: 20px;
    height: 20px;
    margin: -8px 0;
    border-radius: 10px;
    /* Force custom handle - remove native styling */
    outline: none;
    subcontrol-position: center;
    subcontrol-origin: content;
}

QSlider::handle:horizontal:hover {
    background: #404040;
    border: 2px solid #a0a0a0;
}

QSlider::handle:horizontal:pressed {
    background: #505050;
    border: 2px solid #808080;
}

/* Vertical sliders if needed */
QSlider::groove:vertical {
    border: 1px solid #c0c0c0;
    width: 6px;
    background: #f0f0f0;
    border-radius: 3px;
    margin: 0px;
}

QSlider::handle:vertical {
    background: #2c2c2c;
    border: 2px solid #c0c0c0;
    width: 20px;
    height: 20px;
    margin: 0 -8px;
    border-radius: 10px;
    outline: none;
    subcontrol-position: center;
    subcontrol-origin: content;
}

QSlider::handle:vertical:hover {
    background: #404040;
    border: 2px solid #a0a0a0;
}

QSlider::handle:vertical:pressed {
    background: #505050;
    border: 2px solid #808080;
}

/* ComboBox (Dropdown) - Light Theme */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #000000;
    border-radius: 4px;
    padding: 6px 12px;
    color: #000000;
    font-size: 14px;
    min-height: 20px;
}

QComboBox:hover {
    background-color: #f0f0f0;
    border-color: #000000;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
    background: transparent;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #000000;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #000000;
    border-radius: 4px;
    color: #000000;
    selection-background-color: #e0e0e0;
    selection-color: #000000;
}

/* Text Input Fields */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #000000;
    border-radius: 4px;
    padding: 6px 8px;
    color: #000000;
    font-size: 14px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: rgba(100, 150, 200, 0.8);
    background-color: rgba(250, 250, 250, 0.9);
}

/* Spin Box */
QSpinBox, QDoubleSpinBox {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(200, 200, 200, 0.8);
    border-radius: 4px;
    padding: 4px 8px;
    color: #2c2c2c;
    font-size: 14px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: rgba(235, 235, 235, 0.8);
    border: 1px solid rgba(200, 200, 200, 0.8);
    width: 16px;
}

/* CheckBox and RadioButton - FORCE CUSTOM STYLING */
QCheckBox, QRadioButton {
    color: #000000;
    font-size: 14px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #000000;
    background-color: #ffffff;
    border-radius: 3px;
    /* Force custom appearance */
    image: none;
    subcontrol-position: left;
    subcontrol-origin: content;
}

QCheckBox::indicator:unchecked {
    background-color: #ffffff;
    border: 2px solid #000000;
    image: none;
}

QCheckBox::indicator:checked {
    background-color: #000000;
    border: 2px solid #000000;
    /* No image needed - we'll use a simple filled square to indicate checked */
}

QCheckBox::indicator:checked:hover {
    background-color: #404040;
    border: 2px solid #404040;
}

QCheckBox::indicator:unchecked:hover {
    background-color: #f5f5f5;
    border: 2px solid #808080;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #a0a0a0;
    background-color: #ffffff;
    border-radius: 9px;
    /* Force custom appearance */
    image: none;
    subcontrol-position: left;
    subcontrol-origin: content;
}

QRadioButton::indicator:unchecked {
    background-color: #ffffff;
    border: 2px solid #a0a0a0;
}

QRadioButton::indicator:checked {
    background-color: #2c2c2c;
    border: 2px solid #2c2c2c;
    /* Simple filled circle - no image needed */
}

QRadioButton::indicator:checked:hover {
    background-color: #404040;
    border: 2px solid #404040;
}

QRadioButton::indicator:unchecked:hover {
    background-color: #f5f5f5;
    border: 2px solid #808080;
}

/* Buttons */
QPushButton {
    background-color: rgba(240, 240, 240, 0.9);
    border: 1px solid rgba(200, 200, 200, 0.8);
    border-radius: 4px;
    padding: 8px 16px;
    color: #2c2c2c;
    font-size: 14px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: rgba(225, 225, 225, 0.9);
    border-color: rgba(170, 170, 170, 0.8);
}

QPushButton:pressed {
    background-color: rgba(210, 210, 210, 0.9);
    border-color: rgba(180, 180, 180, 0.8);
}

/* Scroll Areas */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background-color: rgba(235, 235, 235, 0.8);
    width: 12px;
    border-radius: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: rgba(160, 160, 160, 0.8);
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(140, 140, 140, 0.8);
}

/* Tab Widget (if present) */
QTabWidget::pane {
    border: 1px solid rgba(200, 200, 200, 0.8);
    border-radius: 4px;
    background-color: rgba(250, 250, 250, 0.95);
}

QTabBar::tab {
    background-color: rgba(240, 240, 240, 0.9);
    border: 1px solid rgba(200, 200, 200, 0.8);
    padding: 8px 16px;
    margin-right: 2px;
    color: #2c2c2c;
}

QTabBar::tab:selected {
    background-color: rgba(220, 220, 220, 0.9);
    border-bottom-color: rgba(220, 220, 220, 0.9);
}

/* Experimental Section Styling */
QLabel[text*="EXPERIMENTAL"] {
    color: #d63384;
    font-weight: bold;
    font-size: 12px;
    text-align: center;
}

/* Close Button (X) */
QPushButton[text="×"], QPushButton[text="✕"] {
    background-color: transparent;
    border: none;
    color: #666666;
    font-size: 18px;
    font-weight: bold;
    padding: 4px;
    max-width: 24px;
    max-height: 24px;
}

QPushButton[text="×"]:hover, QPushButton[text="✕"]:hover {
    background-color: rgba(220, 53, 69, 0.8);
    color: #ffffff;
    border-radius: 12px;
}

/* Specific styling for transparency sliders */
QSlider[objectName*="opacity"] QSlider::groove:horizontal,
QSlider[objectName*="Opacity"] QSlider::groove:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                               stop:0 rgba(240, 240, 240, 0.8),
                               stop:1 rgba(240, 240, 240, 0.2));
}